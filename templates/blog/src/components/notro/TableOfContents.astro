---
/**
 * Notion table of contents block.
 * List items are injected by rehypeTocPlugin with `.notro-toc-item` and `.notro-toc-level-*`.
 * List structure and level indent styles are in the <style> block below.
 */
import type { HTMLAttributes } from 'astro/types';
import { tv, type VariantProps } from 'tailwind-variants';
import { notroColorVariants } from './colors';

export const tableOfContents = tv({
  base: 'my-4 rounded-lg border border-[var(--notro-border)] bg-[var(--notro-bg-subtle)] p-4 text-sm',
  variants: { color: notroColorVariants },
  defaultVariants: { color: 'default' },
});

export const tableOfContentsTitle = tv({ base: 'font-semibold text-sm text-[var(--notro-text-muted)] mb-2' });

type Props = Omit<HTMLAttributes<'nav'>, 'color'> & VariantProps<typeof tableOfContents>;

const { color, class: className, ...rest } = Astro.props;
---

<nav class={tableOfContents({ color, class: className })} aria-label="目次" data-slot="table-of-contents" {...rest}>
  <p class={tableOfContentsTitle()} data-slot="table-of-contents-title">📋 目次</p>
  <slot />
</nav>

<style>
.notro-toc-list {
  list-style: none;
  margin: 0;
  padding: 0;
}
.notro-toc-item {
  line-height: 1.6;
}
.notro-toc-item a {
  text-decoration: none;
  font-size: 0.875rem;
  color: var(--notro-text-muted);
}
.notro-toc-item a:hover {
  text-decoration: underline;
  color: var(--notro-blue);
}
.notro-toc-level-1 { padding-left: 0; }
.notro-toc-level-2 { padding-left: 1rem; }
.notro-toc-level-3 { padding-left: 2rem; }
.notro-toc-level-4 { padding-left: 3rem; }
</style>
