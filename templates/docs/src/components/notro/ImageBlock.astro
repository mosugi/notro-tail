---
/**
 * Notion image block — renders as <figure> with optional caption.
 * Starlight's .sl-markdown-content img handles max-width and display.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'figure'> & {
  src: string;
  alt?: string;
  caption?: string;
};

const { src, alt, caption, class: className, ...rest } = Astro.props;
---

<figure class:list={['notro-image-block', className]} data-slot="image-block" {...rest}>
  <img src={src} alt={alt ?? ''} loading="lazy" decoding="async" data-slot="image-block-img" />
  {caption && (
    <figcaption class="notro-image-block__caption" data-slot="image-block-caption">
      {caption}
    </figcaption>
  )}
</figure>

<style>
  .notro-image-block { margin-block: 1rem; }
  .notro-image-block__caption {
    margin-top: 0.375rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    text-align: center;
  }
</style>
