---
/**
 * Inline mention (user / page / database / data source / agent).
 * Uses Starlight's link color via .sl-markdown-content a.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & { url: string };

const { url, class: className, ...rest } = Astro.props;
---

<a href={url} class={className} data-slot="mention" {...rest}>@<slot /></a>
