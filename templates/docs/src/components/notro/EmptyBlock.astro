---
/**
 * Explicit empty line spacer.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'>;
const { class: className, ...rest } = Astro.props;
---

<div class:list={['notro-empty-block', className]} aria-hidden="true" data-slot="empty-block" {...rest}></div>

<style>
  .notro-empty-block { height: 0.5rem; }
</style>
