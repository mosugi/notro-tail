---
/**
 * Notion page reference link.
 * Inherits Starlight's link color from .sl-markdown-content a.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & { url: string };

const { url, class: className, ...rest } = Astro.props;
---
<a href={url} class={className} data-slot="page-ref" {...rest}>
  <span aria-hidden="true" data-slot="page-ref-icon">📄</span>
  <slot />
</a>
