---
/**
 * Single column inside a Columns layout.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'>;
const { class: className, ...rest } = Astro.props;
---

<div class:list={['notro-column', className]} data-slot="column" {...rest}>
  <slot />
</div>

<style>
  .notro-column { min-width: 0; }
</style>
