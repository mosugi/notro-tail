---
/**
 * Synced block — passes children through as-is.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'> & { url?: string };

const { url, class: className, ...rest } = Astro.props;
const hasSource = url != null && url.length > 0;
---

<div class={className} data-slot="synced-block" data-has-source={hasSource || undefined} {...rest}>
  <slot />
</div>
