---
/**
 * Inline date mention.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'time'> & {
  start: string;
  end?: string;
  startTime?: string;
  timeZone?: string;
};

const { start, end, startTime, timeZone, class: className, ...rest } = Astro.props;

const parts: string[] = [start];
if (startTime) parts.push(startTime);
if (end) parts.push(`→ ${end}`);
if (timeZone) parts.push(`(${timeZone})`);
const display = parts.join(' ');
---

<time class:list={['notro-mention-date', className]} datetime={start} data-slot="mention-date" {...rest}>{display}</time>

<style>
  .notro-mention-date { font-family: var(--__sl-font-mono); font-size: var(--sl-text-sm); }
</style>
