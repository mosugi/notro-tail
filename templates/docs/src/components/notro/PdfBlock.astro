---
/**
 * Notion PDF embed block.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'figure'> & { src: string };

const { src, class: className, ...rest } = Astro.props;
---

<figure class:list={['notro-pdf-block', className]} data-slot="pdf-block" {...rest}>
  <iframe src={src} class="notro-pdf-block__embed" title="PDF" loading="lazy" data-slot="pdf-block-embed"></iframe>
  {Astro.slots.has('default') && (
    <figcaption class="notro-pdf-block__caption" data-slot="pdf-block-caption">
      <slot />
    </figcaption>
  )}
</figure>

<style>
  .notro-pdf-block { margin-block: 1rem; }
  .notro-pdf-block__embed { width: 100%; min-height: 500px; border: none; }
  .notro-pdf-block__caption { margin-top: 0.375rem; font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
</style>
