---
/**
 * Notion toggle (collapsible) block — renders as <details>.
 * Open/close animation and triangle indicator are in the <style> block below.
 */
import type { HTMLAttributes } from 'astro/types';
import { tv, type VariantProps } from 'tailwind-variants';
import { notroColorVariants } from './colors';

export const toggle = tv({
  base: 'notro-toggle my-1.5',
  variants: { color: notroColorVariants },
  defaultVariants: { color: 'default' },
});

type Props = Omit<HTMLAttributes<'details'>, 'color'> & VariantProps<typeof toggle>;

const { color, class: className, ...rest } = Astro.props;
---

<details class={toggle({ color, class: className })} data-slot="toggle" {...rest}>
  <slot />
</details>

<style>
@keyframes notro-toggle-fadein {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.notro-toggle > summary {
  list-style: none;
  cursor: pointer;
  user-select: none;
}
.notro-toggle > summary::-webkit-details-marker {
  display: none;
}
.notro-toggle > summary::before {
  content: "▶";
  display: inline-block;
  font-size: 0.6em;
  margin-right: 0.5em;
  transition: transform 200ms;
  transform-origin: center;
  vertical-align: middle;
  color: var(--notro-text-subtle);
}
.notro-toggle[open] > summary::before {
  transform: rotate(90deg);
}
.notro-toggle > :not(summary) {
  animation: notro-toggle-fadein 0.15s ease;
}
</style>
