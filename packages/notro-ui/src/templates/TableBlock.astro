---
/**
 * Notion table block.
 * Border styles requiring parent context (.notro-table-wrapper > .notro-table) are in the
 * <style> block below.
 */
import type { HTMLAttributes } from 'astro/types';
import { tv } from 'tailwind-variants';

export const tableWrapper = tv({
  base: 'notro-table-wrapper my-4 overflow-x-auto',
  variants: { fitPageWidth: { true: 'w-full', false: '' } },
});

export const table = tv({ base: 'notro-table w-full border-collapse text-sm' });

type Props = HTMLAttributes<'table'> & {
  'fit-page-width'?: string;
  'header-row'?: string;
  'header-column'?: string;
  tableWrapperClass?: string;
};

const {
  'fit-page-width': fitPageWidth = 'false',
  'header-row': headerRow = 'false',
  'header-column': headerColumn = 'false',
  class: className,
  tableWrapperClass,
  ...rest
} = Astro.props;
---

<div class={tableWrapper({ fitPageWidth: fitPageWidth === 'true', class: tableWrapperClass })} data-slot="table-wrapper">
  <table
    class={table({ class: className })}
    data-slot="table"
    data-header-row={headerRow === 'true' ? '' : undefined}
    data-header-col={headerColumn === 'true' ? '' : undefined}
    {...rest}
  >
    <slot />
  </table>
</div>

<style>
.notro-table-wrapper .notro-table td,
.notro-table-wrapper .notro-table th {
  border: 1px solid var(--notro-border);
  padding: 0.375rem 0.75rem;
  text-align: left;
  vertical-align: top;
}
.notro-table-wrapper .notro-table {
  border: 1px solid var(--notro-border);
}
.notro-table[data-header-row] tr:first-child td,
.notro-table[data-header-row] tr:first-child th {
  font-weight: 600;
  background-color: var(--notro-bg-subtle);
}
.notro-table[data-header-col] td:first-child,
.notro-table[data-header-col] th:first-child {
  font-weight: 600;
  background-color: var(--notro-bg-subtle);
}
</style>
